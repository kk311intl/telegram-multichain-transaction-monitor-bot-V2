[Unit]
Description=Crypto Monitor V2 lease coordinator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crypto-monitor-v2-coordinator
Group=crypto-monitor-v2-coordinator
EnvironmentFile=/etc/crypto-monitor-v2/cluster.env
EnvironmentFile=-/etc/crypto-monitor-v2/coordinator-tls.env
EnvironmentFile=-/etc/crypto-monitor-v2/bot.env
WorkingDirectory=/opt/crypto-monitor-v2
ExecStart=/usr/bin/python3 /opt/crypto-monitor-v2/cluster.py --cluster-config /etc/crypto-monitor-v2/cluster.json coordinator --chains-config /etc/crypto-monitor-v2/chains.json --bind ${CLUSTER_BIND} --port 18765 --db /var/lib/crypto-monitor-v2-coordinator/cluster.sqlite3
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/crypto-monitor-v2-coordinator
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
TasksMax=96
UMask=0077
TimeoutStopSec=10
InaccessiblePaths=-/var/lib/crypto-address-monitor -/etc/crypto-address-monitor

[Install]
WantedBy=multi-user.target
